# ─── Required variables ────────────────────────────────────────────────────────
# IBM watsonx.ai API key (get from https://cloud.ibm.com → Manage → Access IAM)
IBM_API_KEY=

# IBM watsonx.ai regional endpoint URL (e.g. https://us-south.ml.cloud.ibm.com)
IBM_ENDPOINT_URL=

# IBM Cloud project ID for your watsonx.ai project
IBM_PROJECT_ID=

# Granite model ID to use for all agents (e.g. ibm/granite-4h-small)
GRANITE_MODEL_ID=ibm/granite-4-h-small

# IBM watsonx.ai embedding model ID for ChromaDB semantic search
# v2 is the current model available in eu-de and other IBM regions
EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr-v2

# Local path where ChromaDB will persist its data
CHROMA_DB_PATH=./chroma_db

# Local path where JSON progress/quiz/plan data files will be stored
JSON_DATA_PATH=./data

# ─── Optional variables (defaults shown) ──────────────────────────────────────
# Maximum number of tokens the model may generate per response
# Minimum recommended is 2048 to avoid truncated JSON responses
MAX_TOKENS=2048

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.3

# Number of characters per text chunk when splitting documents
CHUNK_SIZE=1000

# Number of characters of overlap between consecutive chunks
CHUNK_OVERLAP=150
